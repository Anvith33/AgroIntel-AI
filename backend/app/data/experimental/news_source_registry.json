  ],

  "groq_extraction_schema": {
    "model": "llama-3.3-70b-versatile",
    "instruction": "Extract structured agricultural intelligence from the provided source text. ONLY use information present in the supplied text. Do not use general knowledge as current evidence.",
    "required_fields": [
      "is_agriculture_related",
      "crop",
      "state",
      "district",
      "event_type",
      "impact_direction",
      "severity",
      "confidence",
      "verification_status",
      "supporting_evidence",
      "is_blackswan",
      "geographic_scope"
    ],
    "verification_values": ["VERIFIED", "PLAUSIBLE", "INSUFFICIENT"],
    "impact_directions": ["POSITIVE", "NEGATIVE", "NEUTRAL"],
    "severity_values": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
    "blackswan_criteria": "Confirmed major disruption with actual source evidence: war, export ban, severe multi-district disaster, major pandemic, extreme commodity shock. NOT to be declared from speculative or opinion content."
  },

  "pipeline": {
    "step_1": "Fetch from registered sources via RSS / HTTP",
    "step_2": "Extract title + summary + URL",
    "step_3": "Deduplicate by URL and headline similarity",
    "step_4": "Send retrieved text to Groq Llama 3.3 70B for structured extraction",
    "step_5": "Apply geographic relevance scoring (DISTRICT > STATE > NATIONAL > INTERNATIONAL)",
    "step_6": "Apply freshness scoring (hours/days since publication)",
    "step_7": "Integrate into Crop Recommendation risk signal or Price Advisory layer",
    "critical_rule": "Groq DOES NOT FETCH NEWS. Groq reads retrieved source text ONLY. Groq's internal knowledge is NOT used as current evidence."
  }
